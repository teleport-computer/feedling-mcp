# Feedling — backend + MCP server container image.
#
# One image, two entrypoints (CMD-selected) for the Flask HTTP API and the
# FastMCP SSE server. Non-root, minimal, stateless — state lives in the
# mounted /data volume.
#
# Reproducibility (Phase 1 goal — see docs/DESIGN_E2E.md):
#  - Base image pinned by sha256 digest.
#  - pip deps pinned + hash-verified via requirements.lock (generated by
#    `uv pip compile backend/requirements.txt --generate-hashes`).
#  - System apt packages are the only remaining source of non-determinism;
#    acceptable for Phase 1 and locked down further later if auditors ask.
#
# To upgrade either pin, regenerate and commit both the new digest and the
# new requirements.lock in the same PR. Docs/BUILD.md has the exact steps.

ARG PYTHON_IMAGE=python@sha256:9e01bf1ae5db7649a236da7be1e94ffbbbdd7a93f867dd0d8d5720d9e1f89fab
FROM ${PYTHON_IMAGE} AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FEEDLING_DATA_DIR=/data

WORKDIR /app

# System deps for wheels that compile from source (cryptography, pynacl, …).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libssl-dev \
        libffi-dev \
        curl \
 && rm -rf /var/lib/apt/lists/*

# Hash-verified install. `--require-hashes` fails the build if any package
# drifts from the lockfile, preventing supply-chain swaps at build time.
#
# Two locks, one install: requirements.lock is the shared set every image needs;
# requirements-v2-worker.lock adds what only the V2 serve-worker executes
# (trafilatura for web_fetch article extraction; onnxruntime + tokenizers for
# the memory embedding sweep). It ships here because
# backend / decrypt-enclave / serve-worker all run from this one image. The V1
# agent-runner image installs requirements.lock only and stays free of the HTML
# parser — it never runs the capability. The worker lock is compiled with
# requirements.lock as a constraint, so shared packages pin identically and the
# single --require-hashes install cannot disagree.
COPY backend/requirements.lock ./requirements.lock
COPY backend/requirements-v2-worker.lock ./requirements-v2-worker.lock
RUN pip install --require-hashes -r requirements.lock -r requirements-v2-worker.lock

COPY backend/ ./backend/
COPY ops/ ./ops/

# Memory embedding weights (T523 step 1b). multilingual-e5-small, upstream
# revision 614241f622f53c4eeff9890bdc4f31cfecc418b3, exported to ONNX and
# dynamically quantised to int8 (export recipe: ~/fleet/p1/T523-step1-delivery.md,
# mirrored in docs/CHANGELOG.md). Pulled at build time from a fixed release
# asset and verified against a pinned SHA256 — the application never downloads
# models at runtime (backend/memory/embedding/e5_onnx.py only reads
# FEEDLING_EMBED_MODEL_DIR). Every file in the directory is hashed into the
# embedding model_id at startup, so a changed weight changes the vector version.
# The archive is ~83 MB (~135 MB extracted); it rides in the shared image (backend / enclave /
# serve-worker) because splitting a serve-worker image was deliberately
# deferred (T654). Only the serve-worker ever opens it.
ARG FEEDLING_EMBED_MODEL_URL=https://github.com/teleport-computer/feedling-mcp/releases/download/models-e5-small-614241f6/multilingual-e5-small-614241f6-int8.tar.gz
ARG FEEDLING_EMBED_MODEL_SHA256=f964e4a46307a987ad49f46e8285d51c50199ac57933b3617be9e63546b74e17
RUN set -eu \
 && curl -fsSL --retry 3 -o /tmp/e5.tar.gz "${FEEDLING_EMBED_MODEL_URL}" \
 && echo "${FEEDLING_EMBED_MODEL_SHA256}  /tmp/e5.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/feedling/models/multilingual-e5-small/614241f6 \
 && tar -xzf /tmp/e5.tar.gz -C /opt/feedling/models/multilingual-e5-small/614241f6 \
 && rm /tmp/e5.tar.gz \
 && chmod -R a-w /opt/feedling/models

# Release metadata — baked at build time, read at runtime by
# backend/enclave_app.py and served inside /attestation.enclave_release
# so the iOS audit card can show "git_commit abc1234" instead of "dev".
#
# CI passes these via --build-arg (see .github/workflows/docker-publish.yml).
# Anything missing is OK — enclave_app falls back to "dev".
ARG FEEDLING_GIT_COMMIT=dev
ARG FEEDLING_BUILT_AT=dev
ARG FEEDLING_IMAGE_DIGEST=sha256:dev
ENV FEEDLING_GIT_COMMIT=${FEEDLING_GIT_COMMIT} \
    FEEDLING_BUILT_AT=${FEEDLING_BUILT_AT} \
    FEEDLING_IMAGE_DIGEST=${FEEDLING_IMAGE_DIGEST}

# Run as a fixed non-root UID so bind-mounted volumes on the host can be
# chowned predictably.
RUN useradd --system --uid 1000 --home-dir /home/feedling --create-home feedling \
 && mkdir -p /data /tls /var/lib/feedling-cpu /var/lib/feedling-logs \
 && chown -R feedling:feedling /data /tls /var/lib/feedling-cpu /var/lib/feedling-logs /app \
 && chown -R feedling:feedling /opt/feedling/models
USER feedling

EXPOSE 5001 9998

# Default command runs the ASGI backend (FastAPI, asgi_app:app) under gunicorn
# with the uvicorn worker. `-w 1` here is only the bare-image default: the
# compose files override the whole command and omit `-w`, so worker count is
# env-driven via FEEDLING_BACKEND_WORKERS (backend/gunicorn_conf.py).
# Multi-worker is supported — cross-worker LISTEN/NOTIFY wake bus
# (core/wake_bus.py) plus advisory-lock leader election (core/leader.py) so
# only one worker binds the :9998 WS ingest. Keep in sync with
# deploy/docker-compose.yaml.
CMD ["gunicorn", "--chdir", "backend", "--config", "backend/gunicorn_conf.py", "-w", "1", "-k", "asgi.worker.FeedlingUvicornWorker", "--timeout", "120", "-b", "0.0.0.0:5001", "asgi_app:app"]
