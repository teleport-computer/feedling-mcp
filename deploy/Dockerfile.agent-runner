# Feedling — pooled Hosted Runtime V2 worker image.
#
# The historical package name is retained so existing registries and Phala
# compose authorization keep working, but this image no longer contains or
# starts the hosted resident supervisor, resident consumer, Node, Claude Code,
# Codex CLI, pi CLI, per-user homes, or an /agent-data volume.
#
# Supply-chain pinning (matches the backend image): base pinned by digest below,
# npm CLIs pinned to exact versions, Python deps hash-locked via the backend's
# requirements.lock. To refresh the base digest see deploy/BUILD.md
# (`docker buildx imagetools inspect python:3.11-slim-bookworm`).

# Pinned by multi-arch index digest. Kept at 3.11 (the backend image is 3.12) to
# avoid a runtime minor-version change in this hardening pass; the shared
# requirements.lock carries hashes for both interpreters.
ARG PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:721dc13fd1be0a771e54b72097634291d628d0007dee9da777e2ce676a9c998f
FROM ${PYTHON_IMAGE} AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps required by the hash-locked Python dependency set.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential libssl-dev libffi-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Runtime V2, Genesis, provider, crypto, and PostgreSQL dependencies.
COPY backend/requirements.lock ./requirements.lock
RUN pip install --require-hashes -r requirements.lock

# Runtime V2 is entirely in-process Python. The external resident consumer under
# tools/ is a separately operated product path and is not shipped in this image.
COPY backend/ ./backend/

ARG FEEDLING_GIT_COMMIT=dev
ENV FEEDLING_GIT_COMMIT=${FEEDLING_GIT_COMMIT}

# Non-root worker; all durable turn state lives in PostgreSQL/object storage.
RUN useradd --system --uid 1000 --home-dir /home/feedling --create-home feedling \
 && chown -R feedling:feedling /app
USER feedling

CMD ["python", "-u", "backend/model_api_runtime/v2/serve_worker.py"]
