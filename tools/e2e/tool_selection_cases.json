  "completion_cases": [
    {
      "id": "completion_workspace_read",
      "family": "workspace",
      "utterance": "把我上次写的那份方案的内容读出来看看",
      "tool_steps": [
        {
          "expect": "workspace_list",
          "result": {
            "entries": [
              {"path": "/workspace/plan.md", "revision": 7}
            ]
          }
        },
        {
          "expect": "workspace_read",
          "args_contains": {"path": "/workspace/plan.md"},
          "result": {
            "path": "/workspace/plan.md",
            "revision": 7,
            "content": "周五上线，负责人小王。"
          }
        }
      ],
      "require_visible_reply": true
    },
    {
      "id": "completion_voice_read",
      "family": "voice",
      "utterance": "上次那通电话里我具体说了什么?原话",
      "tool_steps": [
        {
          "expect": "voice_transcript_list",
          "result": {
            "calls": [
              {"call_id": "call_20260818_01", "occurred_at": "2026-08-18T20:00:00Z"}
            ]
          }
        },
        {
          "expect": "voice_transcript_read",
          "args_contains": {"call_id": "call_20260818_01"},
          "result": {
            "call_id": "call_20260818_01",
            "transcript": "我周五下午到上海。"
          }
        }
      ],
      "require_visible_reply": true
    },
